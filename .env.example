# PostgreSQL connection (direct — no BaaS)
DATABASE_URL=postgresql://stonkouva:stonkouva_dev@localhost:5432/stonkouva

# Session signing secret (min 32 chars in production)
SESSION_SECRET=change-me-to-a-long-random-secret-in-production

# Public app URL
APP_URL=http://localhost:3000

# SofaScore API base (server-side only — never call from browser)
SOFASCORE_BASE_URL=https://api.sofascore.com/api/v1

# Optional proxy when SofaScore blocks datacenter IPs (residential proxy URL)
SOFASCORE_PROXY=

# Dev/test: load events from local JSON instead of HTTP (see tests/fixtures/)
SOFASCORE_FIXTURE_PATH=

# Realtime WebSocket server (separate process: npm run realtime)
REALTIME_PORT=4001
NEXT_PUBLIC_REALTIME_URL=ws://localhost:4001

# Optional cron secret for /api/cron/* and /api/sports/sync
CRON_SECRET=

# Set to true only in local dev to seed Greece–Spain demo match
SEED_DEMO_MATCHES=false

# Node environment
NODE_ENV=development

# Force TLS for managed Postgres (Vercel production). true | false | omit for auto
DATABASE_SSL=

# Session cookie settings
SESSION_COOKIE_NAME=sk_session
SESSION_TTL_DAYS=30
# Updated 2026-09-03T15:27:38Z
