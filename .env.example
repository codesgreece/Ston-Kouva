# PostgreSQL connection (direct — no BaaS)
DATABASE_URL=postgresql://stonkouva:stonkouva_dev@localhost:5432/stonkouva

# Session signing secret (min 32 chars in production)
SESSION_SECRET=change-me-to-a-long-random-secret-in-production

# Public app URL
APP_URL=http://localhost:3000

# SofaScore API base (server-side only — never call from browser)
SOFASCORE_BASE_URL=https://api.sofascore.com/api/v1

# Node environment
NODE_ENV=development

# Force TLS for managed Postgres (Vercel production). true | false | omit for auto
DATABASE_SSL=

# Session cookie settings
SESSION_COOKIE_NAME=sk_session
SESSION_TTL_DAYS=30
